            "UPDATE_WHERE"
          ]
        },
        "operations": {
          "operations": {
            "DELETE": {
              "effect": "write",
              "handler": "delete",
              "idempotent": true,
              "input": [
                "key"
              ],
              "output": [
                "result_status"
              ],
              "result_status_values": [
                "SUCCESS",
