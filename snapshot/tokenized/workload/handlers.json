              "result_status_values": [
                "SUCCESS",
                "VIOLATION",
                "BACKEND_ERROR"
              ],
              "summary": "Delete a list of keys; idempotent per key (NOT_FOUND treated as already deleted)"
            },
            "EXISTS": {
              "effect": "read",
              "handler": "exists",
              "idempotent": true,
              "input": [
                "key"
              ],
              "output": [
                "result_status",
                "exists"
              ],
              "result_status_values": [
                "SUCCESS",
                "VIOLATION",
                "BACKEND_ERROR"
              ],
              "summary": "Check if a key exists in storage"
            },
            "LIST": {
              "effect": "read",
              "handler": "list_keys",
              "idempotent": true,
              "input": [],
              "output": [
                "result_status",
                "keys"
              ],
              "result_status_values": [
                "SUCCESS",
                "BACKEND_ERROR"
              ],
              "summary": "List all keys in storage"
            },
